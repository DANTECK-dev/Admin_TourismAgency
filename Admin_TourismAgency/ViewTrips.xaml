<Window x:Class="Admin_TourismAgency.ViewTrips"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Admin_TourismAgency"
        mc:Ignorable="d"
        Title="Список поездок" Height="450" Width="1000">
    <Grid>
        <DataGrid AutoGenerateColumns="False" Grid.Row="1" IsReadOnly="True" Name="_DataGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Поездки"             Width="*"  Binding="{Binding ПОЕЗДКА_ID}"/>
                <DataGridTextColumn Header="ID Клиента"             Width="*"  Binding="{Binding КЛИЕНТ_ID}"/>
                <DataGridTextColumn Header="ID Маршрута"            Width="*"  Binding="{Binding МАРШРУТ_ID}"/>
                <DataGridTextColumn Header="Дата начала поездки"    Width="2*" Binding="{Binding Дата_начала_поездки}"/>
                <DataGridTextColumn Header="Количество дней"        Width="2*" Binding="{Binding Количество_дней}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
